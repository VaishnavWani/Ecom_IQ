# ============================================================
#  EcomIQ — Environment Variables Template
#  Copy this file to .env and fill in your actual values.
#  NEVER put real secrets in this file.
# ============================================================

# ── Gemini AI ────────────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── PostgreSQL Database ───────────────────────────────────────
# Internal Docker hostname for the Postgres container
DB_HOST=ecommerce_iq_db
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# ── Spark / JDBC (used by spark_service) ─────────────────────
# Must use the internal Docker hostname (ecommerce_iq_db), not localhost
JDBC_URL=jdbc:postgresql://ecommerce_iq_db:5432/postgres
JDBC_USER=postgres
JDBC_PASSWORD=your_db_password_here

# ── Kafka ─────────────────────────────────────────────────────
# Internal Docker Kafka address for inter-service communication
KAFKA_BOOTSTRAP_SERVERS=ecom_iq_kafka:29092

# ── Internal Service URLs ─────────────────────────────────────
MCP_SERVER_URL=http://localhost:9500/mcp
